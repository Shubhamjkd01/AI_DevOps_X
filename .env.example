# =================================================================
# AIDEVOPS — Environment Configuration Template
# =================================================================
# Copy this file to .env before starting:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux / macOS:        cp .env.example .env
# =================================================================

# 1. Google Gemini / Gemma API Key (REQUIRED)
# Get a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model options:
# - models/gemini-2.5-pro   (Best for deep multi-file reasoning)
# - models/gemini-1.5-flash (Best for ultra-fast fixes)
# - models/gemma-4-26b-a4b-it
GEMMA_MODEL_NAME=models/gemini-2.5-pro

# 2. GitHub Personal Access Token (REQUIRED for auto-PR creation)
# Generate at: https://github.com/settings/tokens
# Minimal Scopes needed:
# - Actions: Read (to inspect failure logs)
# - Pull Requests: Read & Write (to open automated fix PRs)
# - Contents: Read & Write (to commit fix branches)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# 3. GitHub Webhook Secret (REQUIRED for webhook verification)
# Set any secure passphrase here, and enter the same secret in GitHub Webhook settings:
GITHUB_WEBHOOK_SECRET=your_secure_webhook_secret_phrase

# 4. Local Server Ports
SERVER_PORT=7860
DASHBOARD_PORT=8501

# 5. Target Default Repo (Owner/Repo)
GITHUB_TARGET_REPO=Shubhamjkd01/AI_DevOps_X
